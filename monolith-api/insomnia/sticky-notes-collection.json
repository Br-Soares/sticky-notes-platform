{
  "_type": "export",
  "__export_format": 4,
  "resources": [
    {
      "_id": "wrk_001",
      "_type": "workspace",
      "name": "Sticky Notes API"
    },
    {
      "_id": "env_001",
      "_type": "environment",
      "parentId": "wrk_001",
      "name": "Local",
      "data": { "base_url": "http://localhost:3000", "note_id": "1" }
    },
    {
      "_id": "req_001",
      "_type": "request",
      "parentId": "wrk_001",
      "name": "Create note",
      "method": "POST",
      "url": "{{ base_url }}/notes",
      "body": { "mimeType": "application/json", "text": "{\n  \"title\": \"Minha primeira nota\",\n  \"content\": \"Conteúdo aqui\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_002",
      "_type": "request",
      "parentId": "wrk_001",
      "name": "List all notes",
      "method": "GET",
      "url": "{{ base_url }}/notes",
      "body": {}
    },
    {
      "_id": "req_003",
      "_type": "request",
      "parentId": "wrk_001",
      "name": "Get one note",
      "method": "GET",
      "url": "{{ base_url }}/notes/{{ note_id }}",
      "body": {}
    },
    {
      "_id": "req_004",
      "_type": "request",
      "parentId": "wrk_001",
      "name": "Edit note",
      "method": "PATCH",
      "url": "{{ base_url }}/notes/{{ note_id }}",
      "body": { "mimeType": "application/json", "text": "{\n  \"title\": \"Título editado\",\n  \"content\": \"Conteúdo atualizado\"\n}" },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_005",
      "_type": "request",
      "parentId": "wrk_001",
      "name": "Toggle pin",
      "method": "PATCH",
      "url": "{{ base_url }}/notes/{{ note_id }}/pin",
      "body": {}
    },
    {
      "_id": "req_006",
      "_type": "request",
      "parentId": "wrk_001",
      "name": "Delete note",
      "method": "DELETE",
      "url": "{{ base_url }}/notes/{{ note_id }}",
      "body": {}
    }
  ]
}
